@@ -0,0 +1,117 @@
+"""behavior-2026-run: 시뮬레이터 없이 계획기 반복문 + π0.5 를 시험한다.
+
+2026 평가기와 같은 모양의 관측((1, ...) 배치 축, proprio 61차원, RGBA 224)을 앞서 녹화한 평가 영상에서 만들어
+B1KPolicyWrapper.act 를 N 스텝 부른다. --no-policy 면 π0.5 대신 0 행동을 내는 가짜 정책(GPU 안 씀).
+끝나면 JAX GPU 메모리 사용량(현재·최대)을 찍는다.
+
+  uv run scripts/offline_loop_test.py --steps 96 --fine_grained_level 1 \
+      --video /mnt/c/behavior-2026/outputs/eval_turning_on_radio_20260929_1838/videos/turning_on_radio_301_0.mp4
+"""
+
+import argparse
+import logging
+import time
+
+import cv2
+import numpy as np
+
+from openpi.shared.eval_b1k_wrapper import B1KPolicyWrapper
+
+
+class ZeroPolicy:
+    metadata = {}
+
+    def infer(self, batch):
+        return {"actions": np.zeros((32, 23), dtype=np.float64)}
+
+
+def load_frames(path, start, n, stride):
+    """영상(672x448: 왼쪽 위 왼손목·왼쪽 아래 오른손목 224, 오른쪽 머리 448)에서 머리 화면이 검지 않은 프레임을 뽑는다.
+
+    영상을 한 번만 훑는다(검은 프레임이 많은 영상에서 끝없이 도는 것 방지). 모자라면 뽑은 것을 되풀이한다.
+    """
+    cap = cv2.VideoCapture(path)
+    cap.set(cv2.CAP_PROP_POS_FRAMES, start)
+    frames = []
+    idx = start
+    while len(frames) < n:
+        ok, f = cap.read()
+        if not ok:
+            break
+        idx += 1
+        if (idx - start) % stride:
+            continue
+        f = cv2.cvtColor(f, cv2.COLOR_BGR2RGB)
+        head = cv2.resize(f[:, 224:], (224, 224), interpolation=cv2.INTER_AREA)
+        lw, rw = f[:224, :224], f[224:, :224]
+        if head.mean() < 3:
+            continue
+        frames.append((head, lw, rw))
+    if not frames:
+        raise RuntimeError(f"머리 화면이 검지 않은 프레임이 없다: {path}")
+    print(f"[test] 영상에서 프레임 {len(frames)}장 사용 (마지막 {idx})")
+    return [frames[i % len(frames)] for i in range(n)]
+
+
+def rgba(img):
+    return np.concatenate([img, np.full(img.shape[:2] + (1,), 255, np.uint8)], axis=-1)[None]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--steps", type=int, default=96)
+    ap.add_argument("--video", required=True)
+    ap.add_argument("--start_frame", type=int, default=0)
+    ap.add_argument("--fine_grained_level", type=int, default=1)
+    ap.add_argument("--no-policy", action="store_true")
+    ap.add_argument("--policy_config", default="pi05_b1k-pt50_cs32_bs64_lr2.5e-5_step50k")
+    ap.add_argument("--policy_dir", default="")
+    ap.add_argument("--max_len", type=int, default=32)
+    args = ap.parse_args()
+    logging.basicConfig(level=logging.INFO, force=True)
+
+    if args.no_policy:
+        policy = ZeroPolicy()
+    else:
+        from openpi.policies import policy_config as _policy_config
+        from openpi.training import config as _config
+
+        t = time.monotonic()
+        policy = _policy_config.create_trained_policy(_config.get_config(args.policy_config), args.policy_dir)
+        print(f"[test] π0.5 로딩 {time.monotonic() - t:.1f}s")
+
+    wrapper = B1KPolicyWrapper(
+        policy,
+        task_name="turning_on_radio",
+        control_mode="receeding_horizon",
+        max_len=args.max_len,
+        fine_grained_level=args.fine_grained_level,
+    )
+    wrapper.reset()
+    frames = load_frames(args.video, args.start_frame, args.steps, stride=8)
+    for i in range(args.steps):
+        head, lw, rw = frames[i]
+        obs = {
+            "robot_r1::proprio": np.zeros((1, 61), np.float32),
+            "robot_r1::robot_r1:zed_link:Camera:0::rgb": rgba(head),
+            "robot_r1::robot_r1:left_realsense_link:Camera:0::rgb": rgba(lw),
+            "robot_r1::robot_r1:right_realsense_link:Camera:0::rgb": rgba(rw),
+            "task_id": np.array([0]),
+        }
+        t = time.monotonic()
+        a = wrapper.act(obs)
+        dt = time.monotonic() - t
+        if dt > 0.05 or i == 0:
+            print(f"[test] step {i + 1}: action {tuple(a.shape)} {dt:.2f}s")
+    if not args.no_policy:
+        import jax
+
+        s = jax.local_devices()[0].memory_stats()
+        print(
+            f"[test] JAX GPU 메모리: 현재 {s['bytes_in_use'] / 2**30:.2f} GiB, 최대 {s['peak_bytes_in_use'] / 2**30:.2f} GiB,"
+            f" 한도 {s['bytes_limit'] / 2**30:.2f} GiB"
+        )
+
+
+if __name__ == "__main__":
+    main()
