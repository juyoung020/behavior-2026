-class BlackFrameFiller:
-    """정책 쪽 방어: 카메라 RGB 가 전부 0(검은 화면)이면 그 카메라·그 환경의 직전 정상 프레임으로 바꿔 넣는다.
-
-    behavior-2026 작업공간 src/fasteval/pi05_chunk_server.py 의 BlackFrameFiller(커밋 2388961)와 같은 규칙:
-    - 과거에 받은 RGB 만 쓴다(관측 제한 안). 에피소드 첫 프레임부터 검으면 채울 과거가 없으니 그대로 넘기고 센다.
-    - mode="off" 면 받은 그대로(원래 Comet 과 같음). 환경변수 COMET_BLACK_FILL 로 고른다(기본 last).
-    """
-
-    def __init__(self, mode: str = "last"):
-        self.mode = mode
-        self.last = {}  # (키, 환경) -> 마지막 정상 프레임
-        self.stats = {"frames": 0, "black": 0, "filled": 0, "no_history": 0}
-
-    def reset(self):
-        self.last = {}
-        self.stats = {"frames": 0, "black": 0, "filled": 0, "no_history": 0}
-
-    def __call__(self, obs: dict) -> dict:
-        for key in [k for k in obs if k.endswith("::rgb")]:
-            arr = np.asarray(obs[key])
-            batched = arr.ndim == 4
-            frames = arr if batched else arr[None]
-            out = None
-            for b in range(frames.shape[0]):
-                self.stats["frames"] += 1
-                if frames[b].any():
-                    self.last[(key, b)] = frames[b].copy()
-                    continue
-                self.stats["black"] += 1
-                if self.mode != "last":
-                    continue
-                prev = self.last.get((key, b))
-                if prev is None:
-                    self.stats["no_history"] += 1
-                    continue
-                if out is None:
-                    out = frames.copy()
-                out[b] = prev
-                self.stats["filled"] += 1
-            if out is not None:
-                obs[key] = out if batched else out[0]
-        return obs
-
