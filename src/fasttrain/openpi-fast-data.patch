diff --git a/scripts/b1k/train_b1k.py b/scripts/b1k/train_b1k.py
index b53dc5c..8583fcb 100644
--- a/scripts/b1k/train_b1k.py
+++ b/scripts/b1k/train_b1k.py
@@ -1,4 +1,5 @@
 import dataclasses
+import os
 import functools
 import logging
 import platform
@@ -418,12 +419,19 @@ def main(config: _config.TrainConfig):
     )
     init_wandb(config, resuming=resuming, enabled=config.wandb_enabled)
 
-    data_loader = _data_loader.create_b1k_data_loader(
-        config,
-        sharding=data_sharding,
-        shuffle=True,
-        skip_norm_stats=False
-    )
+    if os.environ.get("FT_FAST_DATA") == "1":
+        # 가속 로더 (behavior-2026/src/fasttrain, docs/학습환경_가속.md): NVDEC + 직접 짠 CUDA 커널, 원래와 비트 동일.
+        # PYTHONPATH 에 behavior-2026/src 가 있어야 한다.
+        from fasttrain.fast import create_fast_b1k_data_loader
+
+        data_loader = create_fast_b1k_data_loader(config, sharding=data_sharding, shuffle=True)
+    else:
+        data_loader = _data_loader.create_b1k_data_loader(
+            config,
+            sharding=data_sharding,
+            shuffle=True,
+            skip_norm_stats=False
+        )
     data_iter = iter(data_loader)
     batch = next(data_iter)
     logging.info(f"Initialized data loader:\n{training_utils.array_tree_to_info(batch)}")
